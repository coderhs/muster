{
  "bundle": {
    "targets": ["deb"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"],
    "category": "DeveloperTool",
    "publisher": "coderhs",
    "homepage": "https://github.com/coderhs/muster",
    "shortDescription": "A board for coding agent sessions",
    "longDescription": "Runs coding agent CLIs in tmux sessions and shows them as cards on a board.",
    "linux": {
      "deb": {
        "section": "devel",
        "depends": ["tmux (>= 3.4)"],
        "recommends": ["libnotify-bin", "xdg-utils"]
      }
    }
  }
}
